# Uygulama Ortamı (development / production)
# ONEMLI: Prod'da 'production' yapın → cookie Secure=True olur (HTTPS zorunlu)
# Local HTTP dev'de 'development' bırakın → cookie Secure=False (login çalışır)
ENV=development

# Backend (FastAPI) portu — SP500 için 8005
PORT=8005

# Arayüz varsayılan dili: en | tr
APP_DEFAULT_LANG=en

# JWT Security
# Prod ortamında mutlaka rastgele güçlü bir şifre belirleyin:
# Örn: openssl rand -hex 32
JWT_SECRET_KEY=kendi_guclu_gizli_anahtarinizi_buraya_yazin

# Veritabanı Bağlantı Bilgileri
DB_USER=postgres
DB_PASSWORD=BURAYA_EN_AZ_16_KARAKTER_GUCLU_SIFRE_YAZIN
DB_NAME=borsa_app
DB_HOST=db
DB_PORT=5432

# FastAPI DB URL (Genelde yukarıdaki DB_* değişkenlerinden Docker-Compose üzerinden oluşturulur)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Yapay Zeka - Gemini API (Google AI Studio üzerinden alınır)
GEMINI_API_KEY=your_gemini_api_key_here

# === Veri Sağlayıcı (HİBRİT) ===
# Geçmiş OHLCV + HACİM her zaman yfinance (hacim doğruluğu için).
# Anlık/canlı fiyat: alpaca (IEX) birincil, hata/eksik/endeks olursa yfinance yedek.
DATA_PROVIDER=alpaca
ALPACA_API_KEY_ID=your_alpaca_key_id
ALPACA_API_SECRET_KEY=your_alpaca_secret
ALPACA_DATA_FEED=iex          # ücretli SIP aboneliğin varsa: sip
# Tamamen yfinance'e dönmek için: DATA_PROVIDER=yfinance

# Telegram Bot (Opsiyonel)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Frontend URL Config (tarayıcı relative /api kullanır; bu daha çok SSR/CSP içindir)
NEXT_PUBLIC_API_URL=http://localhost:8005

# CORS - Prod ortamında frontend adres(ler)i, virgülle ayrılmış
# Local: frontend 3005'te çalışır. Domain'de kendi adresini ekle:
# Ornek: ALLOWED_ORIGINS=https://alanadiniz.com,https://www.alanadiniz.com
ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
